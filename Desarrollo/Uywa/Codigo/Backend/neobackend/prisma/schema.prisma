// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id               Int       @id @default(autoincrement())
  nombres          String
  apellidos        String
  email            String    @unique
  password         String
  dni              Int       @unique
  fechaNacimiento  DateTime
  cantidadReportes Int       @default(0)
  rolId            Int       @default(1)
  rol              Rol       @relation(fields: [rolId], references: [id])
  Reporte          Reporte[]
  Evento           Evento[]
}

model Rol {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique
  descripcion String?
  Usuario     Usuario[]
}

model Departamento {
  id        String      @id @default(cuid())
  nombre    String      @unique
  Evidencia Evidencia[]
}

model Animal {
  id          Int       @id @default(autoincrement())
  nombre      String
  descripcion String
  habitad     String
  estado      String
  imagen_url  String
  video_url   String?
  Reporte     Reporte[]
}

model Evidencia {
  id              Int          @id @default(autoincrement())
  descipcion      String
  imagen_url      String
  latitud         Float
  longitud        Float
  departamento_id String
  departamento    Departamento @relation(fields: [departamento_id], references: [id])
  Reporte         Reporte[]
}

model Reporte {
  id             Int       @id @default(autoincrement())
  fecha_creacion DateTime  @default(now())
  estado         String    @default("pendiente")
  animal_id      Int
  evidencia_id   Int
  usuario_id     Int       @map("user_id")
  usuario        Usuario   @relation(fields: [usuario_id], references: [id])
  animal         Animal    @relation(fields: [animal_id], references: [id])
  evidencia      Evidencia @relation(fields: [evidencia_id], references: [id])
}

model Evento {
  id             Int      @id @default(autoincrement())
  titulo         String
  descripcion    String
  fecha          DateTime
  imagen_url     String?
  user_id        Int
  categoria      String?
  lugar          String?
  usuario        Usuario  @relation(fields: [user_id], references: [id])
  fecha_creacion DateTime @default(now())
}
